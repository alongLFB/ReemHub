NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3000
BUSINESS_TIME_ZONE=Asia/Dubai

# Generate AUTH_SECRET and FIELD_ENCRYPTION_KEY with a cryptographically secure 32-byte generator.
AUTH_SECRET=
