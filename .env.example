NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3035
# Auth.js 的公开访问地址；在 Docker / 反向代理部署中必须与真实外部地址一致。
AUTH_URL=http://localhost:3035
BUSINESS_TIME_ZONE=Asia/Dubai

# Generate AUTH_SECRET and FIELD_ENCRYPTION_KEY with a cryptographically secure 32-byte generator.
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=
DATABASE_URL=postgresql://uaehub:YOUR_URL_ENCODED_POSTGRES_PASSWORD@localhost:5435/uaehub?schema=public

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WORKER_POLL_INTERVAL_MS=30000
OUTBOX_MAX_ATTEMPTS=5
